'=================================
' HAILSTORM
' A BULLET HELL FOR LOWRES NX
'
' TRICKS USED TO PUSH THE SYSTEM
' - 52 BULLET SPRITES, MANY OF THEM
'   CLUSTERS (3, 4 OR 8 BULLETS IN
'   ONE SPRITE) = 200+ ON SCREEN
' - ONE SPRITE HIT CALL CHECKS ALL
'   BULLETS PIXEL-EXACT, FOR BOTH
'   THE HITBOX AND GRAZING
' - RASTER SPLIT: FIXED HUD ON TOP,
'   ENDLESS STARFIELD ON THE SAME
'   LAYER BELOW IT
' - STAGE 1: BULLET CURTAIN DRAWN
'   INTO BG0, SCROLLED IN HARDWARE
' - STAGE 2: A 96X40 BATTLESHIP
'   BUILT FROM BG0 TILES AND MOVED
'   BY SCROLLING, WITH SPRITE
'   TURRETS ON TOP. ITS CORE PHASE
'   ADDS A PER-LINE HEAT WOBBLE
' - STAGE 3: PSEUDO-3D FLOOR. EACH
'   LINE IS SCROLLED SIDEWAYS TO
'   STEER AND RECOLOURED TO MAKE
'   DEPTH BANDS RUSH AT YOU
'
' A = FIRE   B = FOCUS (SLOW MOVE,
' SHOWS HITBOX)
' DOUBLE-TAP B = BOMB: CANCELS ALL
' BULLETS INTO SCORE GEMS
' GRAZING AND GEMS RAISE THE SCORE
' MULTIPLIER (X1-X8). BOMBS HALVE
' IT, DYING RESETS IT
'=================================

GLOBAL PX,PY,SC,HI,LIVES,INV,DEAD,GR,HP,PH,T,BV
GLOBAL BXO,BYO,NB,NS,A1,RO,AA,FL,STG,HPMAX,PHT
GLOBAL SY0,SY1,RA,RB,WL
GLOBAL CURT,CC,LCR,GP,LHB,GOD
GLOBAL BOMBS,BMT,SXP,SYP,BGSX,BGSY,WOB,WP
GLOBAL P1,P2,P3
GLOBAL FLR,SEN,FSPD,MUL,MMAX,DSP,TGR
GLOBAL WV,BLO,QL,DIF,HLR
GLOBAL CHT,UNL,MODE,NDEATH,QESC,SGOLD,EXT
GLOBAL EGX,EGY,WAMP,PAE,ESP
DIM GLOBAL PDX(3),PDY(3)

DIM GLOBAL BX(63),BY(63),BDX(63),BDY(63),BA(63)
DIM GLOBAL BK(63),BT(63),BAG(63),EXC(2)
DIM GLOBAL TC(6),TZ(6),HS(6),TP(6),TN(6)
DIM GLOBAL TH(3),TOX(3),TOY(3),WT(15),FLC(3)
DIM GLOBAL FK(71),FV(71),FXL(71),FPL(71),FC(16)
DIM GLOBAL GA(7),GB(7),DS(3)
'ENEMIES (SPRITES 12-19 DURING WAVES)
DIM GLOBAL QA(7),QX(7),QY(7),QU(7),QV(7),QH(7),QT(7),QG(7)
DIM GLOBAL LT(2),DN$(3),MN$(3)
DN$(0)="EASY"
DN$(1)="NORMAL"
DN$(2)="HARD"
DN$(3)="HELL"
MN$(0)="ARCADE"
MN$(1)="STAGE 2"
MN$(2)="STAGE 3"
MN$(3)="BOSS RUSH"

'BULLET TYPES: CHAR,SIZE,HALF,PAL,
'BULLETS PER SPRITE
'0 SMALL 1 BIG 2 QUAD 3 TRI 4 RING
'5 SPARK, 6 EXPLOSION (HARMLESS)
FOR I=0 TO 6
  READ TC(I),TZ(I),HS(I),TP(I),TN(I)
NEXT I
DATA 5,0,4,2,1,6,0,4,7,1,8,1,8,2,4
DATA 10,1,8,2,3,12,2,12,7,8,15,0,4,3,0
DATA 150,1,8,4,0
'EXPLOSION FRAMES: FLASH, FIRE, SMOKE
EXC(0)=150
EXC(1)=152
EXC(2)=70

'BATTLESHIP TURRET OFFSETS
FOR I=0 TO 3
  READ TOX(I),TOY(I)
NEXT I
DATA 4,6,22,20,58,20,76,6

'HEAT WOBBLE TABLE, BOMB FLASH
FOR I=0 TO 15
  WT(I)=INT(SIN(I*PI/8)*1.6+0.5)
NEXT I
FOR I=0 TO 3
  READ FLC(I)
NEXT I
DATA 1,6,27,63

'FLOOR: STEERING WEIGHT AND DEPTH
'FOR EACH OF THE 72 FLOOR LINES
FOR I=0 TO 71
  FK(I)=(I+8)/80
  FV(I)=INT(1400/(I+6))
NEXT I

'TITLE LOGO GRADIENT, DIFFICULTY
FOR I=0 TO 7
  READ GA(I),GB(I)
NEXT I
DATA 32,48,48,52,52,56,56,60,60,62,56,60,52,56,48,52
FOR I=0 TO 3
  READ DS(I)
NEXT I
DATA 0.8,1,1.2,1.4

'SET GODDBG=1 FOR AN INVINCIBLE TEST
'RUN, FIRSTSTG=2/3 TO SKIP AHEAD
GODDBG=0
FIRSTSTG=1

GAMEPAD 1
DIF=1
CALL HSINIT
HI=PEEKL($E010+DIF*35)
UNL=PEEK($E005)
MODE=0
SEN=%111

VOLUME 2,5,3
VOLUME 3,10,3

CALL SETUPSTARS
CALL STEPSTARS
ON RASTER CALL RAS

'---------------------------------
TITLE:
STOP
PH=0
GOD=GODDBG
CHT=0
CL=0
CB$=""
MSGC=0
CALL RESETPLAY
CALL SETUPSTARS
CALL HUD
BG 0
PAL 7
CALL CTEXT(3,"H A I L S T O R M")
PAL 6
IF UNL AND 16 THEN
  CALL CTEXT(4,"THE STORM HAS PASSED")
ELSE
  CALL CTEXT(4,"BULLET HELL FOR NX")
END IF
PANEL=0
CALL TPANEL(0)
SPRITE 2 PAL 3 SIZE 3
SPRITE 3 PAL 3 SIZE 3 FLIP 1,0
SPRITE 1 PAL 1 SIZE 1
TGR=1
DO
  CALL STEPSTARS
  INC T
  TGR=T+1
  Y=41
  SPRITE 2,48,Y,140
  SPRITE 3,80,Y,140
  OD=DIF
  OM=MODE
  'HELL IS UNLOCKED BY CLEARING HARD
  DMAX=2
  IF UNL AND 2 THEN DMAX=3
  IF LEFT TAP(0) THEN
    DIF=MAX(0,DIF-1)
    CB$=CB$+"L"
  END IF
  IF RIGHT TAP(0) THEN
    DIF=MIN(DMAX,DIF+1)
    CB$=CB$+"R"
  END IF
  'UP/DOWN PICK A MODE, IF ANY ARE
  'UNLOCKED
  IF UP TAP(0) THEN
    CB$=CB$+"U"
    CALL NEXTMODE(-1)
  END IF
  IF DOWN TAP(0) THEN
    CB$=CB$+"D"
    CALL NEXTMODE(1)
  END IF
  IF BUTTON TAP(0,1) THEN CB$=CB$+"B"
  CB$=RIGHT$(CB$,10)
  IF DIF<>OD OR MODE<>OM THEN CL=0
  IF DIF<>OD THEN
    'EACH DIFFICULTY HAS ITS OWN TABLE
    HI=PEEKL($E010+DIF*35)
    CALL HUD
    IF PANEL THEN CALL TPANEL(1)
  END IF
  'ALTERNATE CONTROLS / HIGH SCORES
  IF T MOD 300=0 THEN
    PANEL=1-PANEL
    CALL TPANEL(PANEL)
  END IF
  BG 0
  IF CL=0 THEN
    CL=-1
    BG FILL 0,14 TO 19,14 CHAR 0
    PAL 6
    IF MODE=0 THEN
      CALL CTEXT(14,"< "+DN$(DIF)+" >")
    ELSE
      CALL CTEXT(14,"<"+DN$(DIF)+" "+MN$(MODE)+">")
    END IF
  END IF
  PAL 4
  IF MSGC>0 THEN
    DEC MSGC
  ELSE IF T MOD 60<40 THEN
    CALL CTEXT(15,"   PRESS A   ")
  ELSE
    CALL CTEXT(15,"             ")
  END IF
  IF BUTTON TAP(0,0) THEN
    'CHEAT CODES END WITH THE A PRESS
    'THAT STARTS THE GAME
    C$=CB$+"A"
    M$=""
    IF RIGHT$(C$,10)="UUDDLRLRBA" THEN
      CHT=CHT OR 1
      M$="9 LIVES"
    END IF
    IF RIGHT$(C$,6)="BBBBBA" THEN
      CHT=CHT OR 2
      GOD=1
      M$="INVINCIBLE"
    END IF
    IF RIGHT$(C$,7)="LLRRBBA" THEN
      UNL=15
      POKE $E005,UNL
      M$="ALL UNLOCKED"
    END IF
    IF M$="" THEN EXIT
    'SHOW THE CODE, THEN STAY ON THE
    'TITLE IF IT WAS THE UNLOCK CODE
    PLAY 3,70,30 SOUND 4
    PAL 3
    CALL CTEXT(15," "+M$+" ")
    MSGC=90
    CB$=""
    CL=0
    IF CHT THEN
      WAIT 60
      EXIT
    END IF
  END IF
  WAIT VBL
LOOP
TGR=0
DSP=DS(DIF)
PLAY 2,96,10 SOUND 4

'---------------------------------
GAME:
SC=0
LIVES=3
IF CHT AND 1 THEN LIVES=9
BOMBS=3
GR=0
MUL=1
MMAX=1
NDEATH=0
EXT=0
CLR3=0
NOD3=0
STG=FIRSTSTG
IF MODE=1 OR MODE=2 THEN STG=MODE+1
'GOLD SHIP: REWARD FOR AN X8 CHAIN
IF UNL AND 4 THEN
  PALETTE 1,,36,60,63
ELSE
  PALETTE 1,,4,13,63
END IF

STAGE:
CALL RESETPLAY
PH=1
IF STG=1 THEN
  HP=900
  P1=32
  P2=52
  P3=60
ELSE IF STG=2 THEN
  HP=4*70+450
  P1=21
  P2=26
  P3=56
  FOR K=0 TO 3
    TH(K)=70
  NEXT K
ELSE IF STG=3 THEN
  HP=1100
  P1=36
  P2=56
  P3=62
  FC(0)=17
  FC(16)=18
  FSPD=2
  FZ=0
ELSE
  'SECRET TRUE FINAL BOSS
  HP=1500
  P1=18
  P2=39
  P3=63
  ESP=0.31
END IF
HPMAX=HP
PALETTE 3,,P1,P2,P3
CALL HUD
PX=72
PY=100
INV=90
DEAD=0
BV=0
BXO=56
BYO=-48
SXP=32
SYP=-44
BDRAWN=0
SPRITE 1 PAL 1 SIZE 1
SPRITE 0 PAL 1 PRIO 1
FOR I=2 TO 5
  IF STG=1 THEN
    SPRITE I PAL 3 SIZE 2 FLIP 0,0
  ELSE
    SPRITE I PAL 3 SIZE 1 FLIP 0,0
  END IF
NEXT I
IF STG=3 THEN
  BXO=48
  BYO=-40
  SPRITE 2 SIZE 3
  SPRITE 3 SIZE 3 FLIP 1,0
END IF
IF STG=4 THEN
  FOR I=2 TO 5
    SPRITE I PAL 6
  NEXT I
END IF
FOR I=6 TO 11
  SPRITE I PAL 4 SIZE 0
NEXT I
MUSIC (STG-1)*4
BG 0
PAL 3
IF STG=1 THEN
  CALL CTEXT(8,"STAGE 1")
  PAL 6
  CALL CTEXT(10,"THE STORM BEGINS")
ELSE IF STG=2 THEN
  CALL CTEXT(8,"STAGE 2")
  PAL 6
  CALL CTEXT(10,"BATTLESHIP INBOUND")
ELSE IF STG=3 THEN
  CALL CTEXT(8,"FINAL STAGE")
  PAL 6
  CALL CTEXT(10,"ENTERING THE GRID")
ELSE
  CALL CTEXT(8,"TRUE FINAL")
  PAL 6
  CALL CTEXT(10,"EYE OF THE STORM")
END IF
MSGT=120
WV=1
BLO=20
NB=20
WRN=0
FOR E=0 TO 7
  QA(E)=0
NEXT E
FL=0
PHT=0
BTAP=0
SPIN=0.19

DO
  INC T
  CALL STEPSTARS

  '--- PLAYER MOVEMENT
  FOCUS=BUTTON(0,1)
  IF DEAD=0 THEN
    IF FOCUS THEN SP=0.75 ELSE SP=1.7
    IF LEFT(0) THEN ADD PX,-SP
    IF RIGHT(0) THEN ADD PX,SP
    IF UP(0) THEN ADD PY,-SP
    IF DOWN(0) THEN ADD PY,SP
    PX=MAX(0,MIN(144,PX))
    PY=MAX(12,MIN(112,PY))
    IF BUTTON(0,0) AND T MOD 4=0 THEN
      SPRITE NS,PX+4,PY-4,4
      ADD NS,1,6 TO 11
      PLAY 2,70,2 SOUND 3
    END IF
  END IF

  '--- BOMB: DOUBLE-TAP B
  IF BTAP>0 THEN DEC BTAP
  IF BUTTON TAP(0,1) AND DEAD=0 THEN
    IF BTAP>0 AND BOMBS>0 THEN
      CALL BOMB
      BTAP=0
    ELSE
      BTAP=14
    END IF
  END IF
  IF BMT>0 THEN
    DEC BMT
    PALETTE 0,FLC(BMT\4),,,
  END IF

  '--- PLAYER SHOTS (POSITION LIVES IN
  '--- THE SPRITE REGISTERS ITSELF)
  FOR I=6 TO 11
    Y=SPRITE.Y(I)
    IF Y>-20 THEN
      IF Y<4 THEN
        SPRITE OFF I
      ELSE
        SPRITE I,,Y-6,
        IF WV=2 THEN
          IF SPRITE HIT(I,12 TO 19) THEN
            E=HIT-12
            IF QA(E) THEN
              SPRITE OFF I
              CALL HURTE(E,1)
            END IF
          END IF
        END IF
        IF BV THEN
          IF SPRITE HIT(I,2 TO 5) THEN
            SPRITE OFF I
            IF STG=4 THEN
              'SHIELD PODS BLOCK SHOTS
              PLAY 3,60,1 SOUND 6
            ELSE IF STG<>2 THEN
              CALL BOSSHIT
            ELSE
              K=HIT-2
              IF TH(K)>0 THEN
                DEC TH(K)
                CALL BOSSHIT
                IF TH(K)=0 THEN CALL TURRETDOWN(K)
              END IF
            END IF
          ELSE IF STG=4 THEN
            'THE EYE IS ALL TARGET: ANY TILE
            LX=SPRITE.X(I)+4-INT(SXP)
            LY=Y-6-INT(SYP)
            IF LX>=0 AND LX<64 AND LY>=0 AND LY<64 THEN
              BG 0
              IF CELL.C(LX\8,LY\8+2)>0 THEN
                SPRITE OFF I
                CALL BOSSHIT
              END IF
            END IF
          ELSE IF STG=2 THEN
            'CENTRE ARMOR/CORE: LOOK UP THE BG
            'TILE. SHOTS PASS OVER THE WINGS
            LX=SPRITE.X(I)+4-INT(SXP)
            LY=Y-6-INT(SYP)
            IF LX>=30 AND LX<66 AND LY>=0 AND LY<40 THEN
              BG 0
              IF CELL.C(LX\8,LY\8+2)>0 THEN
                SPRITE OFF I
                IF PH=2 THEN CALL BOSSHIT
              END IF
            END IF
          END IF
        END IF
      END IF
    END IF
  NEXT I

  '--- BULLETS AND SCORE GEMS
  CALL MOVEB

  '--- ENEMY WAVES: A SPAWNER WORKS
  '--- THROUGH THE STAGE'S DATA SCRIPT
  IF WV=2 THEN
    INC WVT
    IF SQN>0 THEN
      DEC SQC
      IF SQC<=0 THEN
        CALL SPAWN(SQT,SQX,SQI)
        ADD SQX,SQDX
        INC SQI
        DEC SQN
        SQC=SQD
      END IF
    ELSE IF NWT>=0 AND WVT>=NWT THEN
      SQT=NTY
      SQX=NXX
      SQN=NN
      SQD=NDT
      SQDX=NDX
      SQC=0
      SQI=0
      READ NWT,NTY,NXX,NN,NDT,NDX
    END IF
    CALL MOVEE
    IF NWT<0 AND SQN=0 AND QL=0 AND QESC=0 AND SGOLD=0 AND MODE<>3 AND STG<4 THEN
      'SECRET: NOTHING ESCAPED, SO A GOLD
      'GUNSHIP SHOWS UP BEFORE THE BOSS
      SGOLD=-1
      CALL SPAWN(3,-16,0)
      PLAY 3,80,40 SOUND 4
    ELSE IF NWT<0 AND SQN=0 AND QL=0 THEN
      'WAVES CLEARED: SIREN, THEN BOSS
      WV=0
      BLO=12
      WRN=120
      IF STG=4 THEN
        'THE EYE: BG TILES FROM ROM 5
        BG 0
        CLS 0
        BG SOURCE ROM(5)
        BG COPY 0,0,8,8 TO 0,2
        BG SOURCE ROM(3)
        SXP=48
        SYP=-64
        BDRAWN=-1
      END IF
      IF STG<3 THEN
        BG 0
        PAL 3
        CALL CTEXT(8,"WARNING")
        PAL 6
        IF STG=1 THEN CALL CTEXT(10,"BOSS APPROACHING")
        IF STG=2 THEN CALL CTEXT(10,"BATTLESHIP")
        MSGT=150
      END IF
    END IF
  END IF
  IF WRN>0 THEN
    DEC WRN
    IF WRN MOD 30=29 THEN PLAY 3,62,14 SOUND 4
    IF WRN MOD 30<15 AND WRN>0 THEN
      PALETTE 0,16,,,
    ELSE
      PALETTE 0,1,,,
    END IF
  END IF

  '--- BOSS
  IF WV>0 THEN
    'NO BOSS DURING THE WAVES
  ELSE IF STG=1 THEN
    IF HP>0 THEN
      IF BYO<12 THEN
        ADD BYO,0.5
      ELSE IF PHT=0 THEN
        BV=-1
      END IF
      BXO=56+SIN(T*0.021)*44
      SPRITE 2,BXO,BYO,48
      SPRITE 3,BXO+24,BYO,51
      SPRITE 4,BXO,BYO+24,96
      SPRITE 5,BXO+24,BYO+24,99
      GX=BXO+24
      GY=BYO+30
    END IF
  ELSE IF STG=2 THEN
    IF BDRAWN AND HP>0 THEN
      IF SYP<14 THEN
        ADD SYP,0.5
      ELSE IF PHT=0 THEN
        BV=-1
      END IF
      SXP=32+SIN(T*0.015)*30
      BGSX=-INT(SXP) AND 255
      BGSY=(16-INT(SYP)) AND 255
      IF WOB=0 THEN SCROLL 0,BGSX,BGSY
      FOR K=0 TO 3
        Y=INT(SYP)+TOY(K)
        IF Y<4 THEN Y=-32
        SPRITE 2+K,INT(SXP)+TOX(K),Y,
      NEXT K
      IF T MOD 3=0 THEN INC WP
    END IF
  ELSE IF STG=4 THEN
    IF BDRAWN AND HP>0 THEN CALL EYEMOVE
  ELSE IF HP>0 THEN
    'STAGE 3: WING SHIP, ONE 32X32 HALF
    'DRAWN TWICE (RIGHT ONE FLIPPED),
    'PLUS TWO ORBITING PODS
    IF BYO<14 THEN
      ADD BYO,0.5
    ELSE IF PHT=0 THEN
      BV=-1
    END IF
    BXO=48+SIN(T*0.017)*40
    YB=BYO+SIN(T*0.05)*3
    SPRITE 2,BXO,YB,140
    SPRITE 3,BXO+32,YB,140
    POA=T*(0.03+PH*0.015)
    Q4X=BXO+24+COS(POA)*40
    Q4Y=YB+8+SIN(POA)*14
    Q5X=BXO+24-COS(POA)*40
    Q5Y=YB+8-SIN(POA)*14
    SPRITE 4,Q4X,Q4Y,138
    SPRITE 5,Q5X,Q5Y,138
    GX=BXO+32
    GY=YB+26
  END IF
  IF FL=2 THEN PALETTE 3,,52,62,63
  IF FL=1 THEN PALETTE 3,,P1,P2,P3
  IF FL>0 THEN DEC FL

  '--- ATTACK PATTERNS
  IF BV AND DEAD=0 THEN
    IF STG=1 THEN
      IF PH=1 THEN
        IF T MOD 6=0 THEN
          CALL FIRE(GX,GY,A1,1.2,3)
          CALL FIRE(GX,GY,A1+PI,1.2,3)
          ADD A1,0.37
        END IF
        IF T MOD 40=0 THEN
          CALL AIM(GX,GY)
          CALL FIRE(GX,GY,AA,1.3,2)
        END IF
      ELSE IF PH=2 THEN
        IF T MOD 40=0 THEN
          FOR K=0 TO 9
            CALL FIRE(GX,GY,K*PI/5+RO,0.9,1)
          NEXT K
          ADD RO,0.16
        END IF
        IF T MOD 45=20 THEN
          CALL AIM(GX,GY)
          CALL FIRE(GX,GY,AA,0.65,4)
          CALL FIRE(GX,GY,AA-0.55,0.65,4)
          CALL FIRE(GX,GY,AA+0.55,0.65,4)
        END IF
      ELSE
        IF T MOD 32=0 THEN
          CALL AIM(GX,GY)
          FOR K=-2 TO 2
            CALL FIRE(GX,GY,AA+K*0.22,1.4,0)
          NEXT K
        END IF
        IF T MOD 9=0 THEN
          CALL FIRE(GX,GY,A1,0.8,2)
          ADD A1,0.53
        END IF
      END IF
    ELSE IF STG=2 THEN
      IF PH=1 THEN
        'BATTLESHIP: TURRETS
        FOR K=0 TO 3
          IF TH(K)>0 THEN
            TX=SXP+TOX(K)+8
            TY=SYP+TOY(K)+14
            IF (T+K*13) MOD 56=0 THEN
              CALL AIM(TX,TY)
              FOR J=-1 TO 1
                CALL FIRE(TX,TY,AA+J*0.3,1.3,0)
              NEXT J
            END IF
            IF (K=0 OR K=3) AND (T+K*7) MOD 28=0 THEN
              CALL FIRE(TX,TY,PI/2+SIN(T*0.05+K)*0.9,1,1)
            END IF
          END IF
        NEXT K
        IF T MOD 70=35 THEN
          FOR J=-1 TO 1
            CALL FIRE(SXP+48,SYP+36,PI/2+J*0.6,0.9,2)
          NEXT J
        END IF
      ELSE
        'BATTLESHIP: OPEN CORE
        GX=SXP+48
        GY=SYP+20
        IF T MOD 7=0 THEN
          CALL FIRE(GX,GY,A1,1.1,3)
          CALL FIRE(GX,GY,A1+PI,1.1,3)
          ADD A1,SPIN
          IF T MOD 140=0 THEN SPIN=-SPIN
        END IF
        IF T MOD 70=35 THEN
          FOR J=0 TO 7
            CALL FIRE(GX,GY,J*PI/4+RO,0.75,1)
          NEXT J
          ADD RO,0.2
        END IF
      END IF
    ELSE IF STG=4 THEN
      CALL EYEFIRE
    ELSE IF PH=1 THEN
      'STAGE 3 PHASE 1: PODS AIM, SHIP RAINS
      IF T MOD 48=0 THEN
        CALL AIM(Q4X+8,Q4Y+8)
        FOR J=-1 TO 1
          CALL FIRE(Q4X+8,Q4Y+8,AA+J*0.25,1.3,0)
        NEXT J
      ELSE IF T MOD 48=24 THEN
        CALL AIM(Q5X+8,Q5Y+8)
        FOR J=-1 TO 1
          CALL FIRE(Q5X+8,Q5Y+8,AA+J*0.25,1.3,0)
        NEXT J
      END IF
      IF T MOD 6=0 THEN
        CALL FIRE(GX,GY,PI/2+(RND-0.5)*1.5,1+RND*0.5,1)
      END IF
    ELSE IF PH=2 THEN
      'PHASE 2: 3-ARM QUAD SPIRAL, RINGS
      IF T MOD 12=0 THEN
        FOR J=0 TO 2
          CALL FIRE(GX,GY,A1+J*2.0944,0.9,2)
        NEXT J
        ADD A1,0.23
      END IF
      IF T MOD 60=30 THEN
        CALL AIM(Q4X+8,Q4Y+8)
        CALL FIRE(Q4X+8,Q4Y+8,AA,0.7,4)
        CALL AIM(Q5X+8,Q5Y+8)
        CALL FIRE(Q5X+8,Q5Y+8,AA,0.7,4)
      END IF
    ELSE
      'PHASE 3: COUNTER-SPINNING FLOWER
      'PLUS AIMED FANS
      IF T MOD 6=0 THEN
        CALL FIRE(GX,GY,A1,1.05,3)
        CALL FIRE(GX,GY,-A1,1.05,3)
        ADD A1,0.29
      END IF
      IF T MOD 40=20 THEN
        CALL AIM(GX,GY)
        FOR J=-3 TO 3
          CALL FIRE(GX,GY,AA+J*0.18,1.6,0)
        NEXT J
      END IF
    END IF
  END IF

  '--- BULLET CURTAIN IN BG0 (STAGE 1)
  IF STG=1 AND PH=3 AND HP>0 THEN
    ADD SY0,-1,0 TO 255
    SCROLL 0,0,SY0
    CR=INT((SY0+4)/8) AND 31
    IF CR<>LCR THEN
      LCR=CR
      BG 0
      BG FILL 0,CR TO 19,CR CHAR 0
      IF CURT AND CC MOD 3=0 THEN
        PAL 5
        OF=(CC\3) MOD 2
        FOR K=OF TO 19 STEP 2
          IF K<GP OR K>GP+4 THEN CELL K,CR,32
        NEXT K
        ADD GP,RND(4)-2
        GP=MAX(0,MIN(15,GP))
      END IF
      INC CC
    END IF
  END IF

  '--- PSEUDO-3D FLOOR (STAGE 3): WORK
  '--- OUT EVERY LINE'S SCROLL AND
  '--- COLOUR FOR THE RASTER SUB
  IF FLR THEN
    ADD FZ,FSPD
    CAMX=(PX-72)*0.7
    FOR J=6 TO 71
      FXL(J)=48+CAMX*FK(J)
      FPL(J)=FC((FV(J)+FZ) AND 16)
    NEXT J
  END IF

  '--- PLAYER SPRITES AND COLLISION
  IF DEAD=0 THEN
    'SHIP FRAME: UPRIGHT OR BANKED
    '(LEFT = BANKED RIGHT, MIRRORED),
    'ENGINE FLAME FLICKERS
    FR=(T\3) MOD 2
    IF LEFT(0) THEN
      SCH=146+FR*2
      SPRITE 1 FLIP 1,0
    ELSE IF RIGHT(0) THEN
      SCH=146+FR*2
      SPRITE 1 FLIP 0,0
    ELSE
      SCH=2+FR*142
      SPRITE 1 FLIP 0,0
    END IF
    IF INV>0 AND INV MOD 6<3 THEN
      SPRITE 1,PX,-32,SCH
      SPRITE 0,PX+4,-32,1
    ELSE
      SPRITE 1,PX,PY,SCH
      SPRITE 0,PX+4,PY+4,1
    END IF
    IF INV=0 AND GOD=0 THEN
      'GEMS AND SPARKS SHARE THE SLOTS,
      'SO SKIP PAST ANY HARMLESS HIT
      HITP=0
      H0=12
      WHILE H0<=63
        IF SPRITE HIT(0,H0 TO 63) THEN
          IF BK(HIT)=0 OR BK(HIT)=4 THEN
            HITP=-1
            H0=64
          ELSE
            H0=HIT+1
          END IF
        ELSE
          H0=64
        END IF
      WEND
      IF STG=1 AND PH=3 AND HITP=0 THEN
        HXP=INT(PX)+7
        MY=(INT(PY)+7+SY0) AND 255
        BG 0
        IF CELL.C(HXP\8,MY\8)=32 THEN
          LX=HXP MOD 8
          LY=MY MOD 8
          IF LX>=1 AND LX<=6 AND LY>=1 AND LY<=6 THEN HITP=-1
        END IF
      END IF
      IF HITP THEN
        CALL PLAYERDIE
      ELSE IF SPRITE HIT(1,12 TO 63) THEN
        IF BK(HIT)=0 THEN
          INC GR
          IF GR=1500 AND EXT=0 THEN
            'SECRET: GRAZE EXTEND
            EXT=-1
            INC LIVES
            CALL HUD
            PLAY 3,90,40 SOUND 4
          END IF
          CALL SCORE(3)
          CALL ADDMUL(0.015)
          IF GR MOD 6=0 THEN PLAY 2,90,1 SOUND 4
        END IF
      END IF
    END IF
    IF INV>0 THEN DEC INV
    IF FOCUS AND DEAD=0 THEN SPRITE 0,,,17
  ELSE
    DEC DEAD
    IF DEAD=0 THEN
      IF LIVES<0 THEN EXIT
      PX=72
      PY=100
    END IF
  END IF

  '--- PHASE CHANGES (ONLY ONCE THE BOSS
  '--- IS OUT, NEVER DURING THE WAVES)
  IF WV>0 THEN
    'NOTHING YET
  ELSE IF STG=1 THEN
    IF PH=1 AND HP<=600 THEN
      CALL NEWPHASE(2,"PHASE 2")
      MSGT=80
    ELSE IF PH=2 AND HP<=300 THEN
      CALL NEWPHASE(3,"FINAL PHASE")
      MSGT=80
    END IF
  ELSE IF STG=2 THEN
    IF PH=1 AND TH(0)+TH(1)+TH(2)+TH(3)=0 THEN
      'ALL TURRETS DOWN: OPEN THE CORE
      CALL PHASEUP(2)
      BG 0
      BG COPY 4,6,4,3 TO 4,3
      WOB=-1
    END IF
  ELSE IF STG=4 THEN
    IF PH=1 AND HP<=1000 THEN
      'VORTEX: THE EYE SHIMMERS HARD
      CALL PHASEUP(2)
      WOB=-1
      WAMP=2
    ELSE IF PH=2 AND HP<=500 THEN
      'STORM EYE: LIGHTNING
      CALL PHASEUP(3)
      WOB=0
      SCROLL 0,BGSX,BGSY
    END IF
  ELSE
    IF PH=1 AND HP<=750 THEN
      CALL PHASEUP(2)
    ELSE IF PH=2 AND HP<=380 THEN
      'FINAL PHASE: THE GRID TURNS RED
      CALL PHASEUP(3)
      FC(0)=16
      FC(16)=32
      PALETTE 5,,,,52
      FSPD=4
    END IF
  END IF
  IF PHT>0 THEN
    DEC PHT
    IF PHT=0 THEN
      BV=-1
      IF STG=1 AND PH=3 THEN CURT=-1
    END IF
  END IF
  IF MSGT>0 THEN
    DEC MSGT
    IF MSGT=0 THEN
      IF WV=1 THEN
        'STAGE CARD DONE: START THE WAVES
        BG 0
        CLS 0
        IF STG=3 THEN CALL DRAWFLOOR
        WV=2
        WVT=0
        SQN=0
        IF STG=1 THEN RESTORE W1
        IF STG=2 THEN RESTORE W2
        IF STG=3 THEN RESTORE W3
        'STAGE 4 HAS NO WAVES (NWT=-1 BELOW)
        IF STG=4 THEN RESTORE W1
        READ NWT,NTY,NXX,NN,NDT,NDX
        QESC=0
        SGOLD=0
        IF MODE=3 OR STG=4 THEN NWT=-1
      ELSE IF STG=1 THEN
        IF PH<3 THEN CLS 0
      ELSE IF STG=2 THEN
        IF BDRAWN=0 THEN
          'DRAW THE BATTLESHIP INTO BG0
          BG 0
          CLS 0
          BG COPY 0,0,12,5 TO 0,2
          SCROLL 0,0,60
          FOR K=0 TO 3
            SPRITE 2+K,,,40
          NEXT K
          BDRAWN=-1
        END IF
      END IF
    END IF
  END IF
  IF HP<=0 THEN EXIT

  '--- HUD
  IF T MOD 4=0 THEN
    BG 1
    PAL 6
    NUMBER 0,0,SC,6
    NUMBER 8,0,INT(MUL),1
    HB=INT(HP*20/HPMAX+0.99)
    IF WV THEN HB=0
    IF HB<>LHB THEN
      LHB=HB
      IF HB>0 THEN BG FILL 0,1 TO HB-1,1 CHAR 37
      IF HB<20 THEN BG FILL HB,1 TO 19,1 CHAR 38
    END IF
  END IF

  WAIT VBL
LOOP

'---------------------------------
IF HP<=0 THEN
  'BOSS DEFEATED: BULLETS BECOME GEMS
  BV=0
  CURT=0
  BMT=0
  PALETTE 0,1,,,
  INV=9999
  CALL CANCEL
  STOP
  IF STG=1 THEN
    EX=BXO
    EY=BYO
    EW=48
    EH=48
    BG 0
    CLS 0
    SY0=0
    SCROLL 0,0,0
  ELSE IF STG=2 THEN
    EX=SXP
    EY=SYP
    EW=96
    EH=40
  ELSE IF STG=4 THEN
    EX=SXP
    EY=SYP
    EW=64
    EH=64
  ELSE
    EX=BXO
    EY=BYO
    EW=64
    EH=32
    SPRITE OFF 4 TO 5
    FSPD=1
  END IF
  FOR N=0 TO 119
    CALL STEPSTARS
    IF N MOD 4=0 THEN
      CALL FIRE(EX+RND(EW),EY+RND(EH),RND*2*PI,0.2,6)
      CALL FIRE(EX+RND(EW),EY+RND(EH),RND*2*PI,0.6+RND,5)
      PLAY 3,10+RND(20),12 SOUND 5
    END IF
    IF N=96 THEN
      'FINAL BLAST: A RING OF FIREBALLS
      FOR J=0 TO 7
        CALL FIRE(EX+EW/2,EY+EH/2,J*PI/4,0.9,6)
      NEXT J
      PLAY 3,6,40 SOUND 7
    END IF
    IF N MOD 8<4 THEN
      PALETTE 3,,63,63,63
    ELSE
      PALETTE 3,,P1,P2,P3
    END IF
    CALL MOVEB
    IF FLR THEN
      ADD FZ,FSPD
      FOR J=6 TO 71
        FPL(J)=FC((FV(J)+FZ) AND 16)
      NEXT J
    END IF
    SPRITE 1,PX,PY,2+((N\3) MOD 2)*142
    SPRITE 1 FLIP 0,0
    SPRITE 0,PX+4,PY+4,1
    IF N=100 THEN
      IF STG=2 OR STG=4 THEN
        WOB=0
        BG 0
        CLS 0
      END IF
      SPRITE OFF 2 TO 5
      'VICTORY FANFARE
      TRACK 12,0
      TRACK 13,1
    END IF
    WAIT VBL
  NEXT N
  SPRITE OFF 2 TO 5
  CALL CLEARB
  BONUS=(LIVES+1)*5000+STG*10000
  IF STG=4 THEN ADD BONUS,100000
  ADD SC,BONUS
  IF STG=3 THEN
    CLR3=-1
    IF NDEATH=0 THEN NOD3=-1
  END IF
  'NO LIVES LOST BY STAGE 3 (AND NO
  'CHEATS) = THE SECRET STAGE 4
  IF STG<3 OR (STG=3 AND NDEATH=0 AND CHT=0) THEN
    'STAGE CLEAR, ON TO THE NEXT
    SPRITE OFF 6 TO 11
    BG 0
    CLS 0
    SCROLL 0,0,0
    PAL 3
    CALL CTEXT(6,"STAGE CLEAR")
    PAL 6
    CALL CTEXT(8,"BONUS")
    NUMBER 7,9,BONUS,6
    CALL HUD
    FOR N=0 TO 179
      CALL STEPSTARS
      IF STG=3 AND N=100 THEN
        BG 0
        PAL 3
        CALL CTEXT(12,"IT IS NOT OVER")
        PLAY 3,62,40 SOUND 4
      END IF
      WAIT VBL
    NEXT N
    INC STG
    GOTO STAGE
  END IF
  RES$="ALL CLEAR!"
  IF STG=4 THEN
    'THE TRUE ENDING
    RES$="TRUE ENDING"
    SPRITE OFF
    BG 0
    CLS 0
    SCROLL 0,0,0
    PAL 3
    CALL CTEXT(4,"THE EYE IS CLOSED")
    PAL 6
    CALL CTEXT(6,"THE STORM HAS PASSED")
    PAL 4
    CALL CTEXT(9,"TRUE ENDING")
    PAL 1
    CALL CTEXT(12,"THANKS FOR PLAYING")
    WAIT 90
    DO
      CALL STEPSTARS
      IF BUTTON TAP(0,0) THEN EXIT
      WAIT VBL
    LOOP
  END IF
ELSE
  RES$="GAME OVER"
  BONUS=-1
END IF

'---------------------------------
'RESULTS
IF BONUS<0 THEN STOP
WAIT 30
CALL RESETPLAY
'RANK IN THIS DIFFICULTY'S TOP 5
'(CHEATED RUNS DON'T COUNT)
RK=5
IF CHT=0 THEN
  FOR R=4 TO 0 STEP -1
    IF SC>PEEKL($E010+DIF*35+R*7) THEN RK=R
  NEXT R
END IF
'UNLOCKS: 1 STAGE SELECT, 2 HELL,
'4 GOLD SHIP, 8 BOSS RUSH
NU=UNL
IF CHT=0 THEN
  IF CLR3 THEN
    NU=NU OR 1
    IF DIF>=2 AND MODE=0 THEN NU=NU OR 2
    IF NOD3 AND MODE=0 THEN NU=NU OR 8
  END IF
  IF BONUS>=0 AND STG=4 THEN NU=NU OR 16
  IF MMAX>=8 THEN NU=NU OR 4
END IF
GAIN=NU AND (NOT UNL)
UNL=NU
POKE $E005,UNL
IF RK=0 THEN HI=SC
CALL HUD
BG 0
PAL 3
CALL CTEXT(3,RES$)
PAL 6
IF BONUS>=0 THEN
  CALL CTEXT(5,"CLEAR BONUS")
  NUMBER 7,6,BONUS,6
END IF
CALL CTEXT(8,"SCORE")
NUMBER 7,9,SC,6
CALL CTEXT(10,"GRAZE")
NUMBER 8,11,GR,4
TEXT 4,12,"BEST CHAIN X"
NUMBER 16,12,MMAX,1
PAL 4
IF CHT THEN
  CALL CTEXT(14,"CHEAT: NOT SAVED")
ELSE IF RK=0 THEN
  CALL CTEXT(14,"NEW HIGH SCORE!")
ELSE IF RK<5 THEN
  CALL CTEXT(14,"TOP 5 SCORE!")
END IF
WAIT 60
DO
  CALL STEPSTARS
  IF BUTTON TAP(0,0) THEN EXIT
  WAIT VBL
LOOP

IF RK<5 THEN
  'NAME ENTRY: UP/DOWN PICKS A LETTER,
  'A CONFIRMS, B GOES BACK
  BG 0
  CLS 0
  PAL 3
  CALL CTEXT(4,"ENTER YOUR NAME")
  PAL 6
  CALL CTEXT(12,"UP DOWN  LETTER")
  CALL CTEXT(13,"A NEXT  B BACK")
  FOR K=0 TO 2
    LT(K)=65
  NEXT K
  NPOS=0
  DO
    CALL STEPSTARS
    INC T
    IF UP TAP(0) THEN ADD LT(NPOS),1,65 TO 90
    IF DOWN TAP(0) THEN ADD LT(NPOS),-1,65 TO 90
    IF BUTTON TAP(0,1) AND NPOS>0 THEN DEC NPOS
    IF BUTTON TAP(0,0) THEN
      INC NPOS
      PLAY 2,80+NPOS*4,6 SOUND 4
      IF NPOS>2 THEN EXIT
    END IF
    FOR K=0 TO 2
      IF K=NPOS AND T MOD 20<10 THEN PAL 4 ELSE PAL 6
      TEXT 7+K*2,8,CHR$(LT(K))
    NEXT K
    WAIT VBL
  LOOP
  'SHIFT LOWER ENTRIES DOWN, WRITE OURS
  A=$E010+DIF*35+RK*7
  IF RK<4 THEN COPY A,(4-RK)*7 TO A+7
  POKEL A,SC
  FOR K=0 TO 2
    POKE A+4+K,LT(K)
  NEXT K
END IF

'NEW UNLOCKS
IF GAIN THEN
  BG 0
  CLS 0
  PAL 3
  CALL CTEXT(4,"UNLOCKED!")
  PAL 6
  RW=7
  IF GAIN AND 1 THEN
    CALL CTEXT(RW,"STAGE SELECT")
    INC RW
  END IF
  IF GAIN AND 2 THEN
    CALL CTEXT(RW,"HELL DIFFICULTY")
    INC RW
  END IF
  IF GAIN AND 4 THEN
    CALL CTEXT(RW,"GOLD SHIP")
    INC RW
  END IF
  IF GAIN AND 8 THEN
    CALL CTEXT(RW,"BOSS RUSH")
    INC RW
  END IF
  IF GAIN AND 16 THEN
    CALL CTEXT(RW,"TRUE ENDING")
    INC RW
  END IF
  PAL 1
  CALL CTEXT(13,"UP/DOWN ON TITLE")
  PLAY 3,70,40 SOUND 4
  WAIT 60
  DO
    CALL STEPSTARS
    IF BUTTON TAP(0,0) THEN EXIT
    WAIT VBL
  LOOP
END IF

'SHOW THE TABLE
BG 0
CLS 0
PAL 3
CALL CTEXT(3,"TOP 5")
PAL 6
CALL CTEXT(4,DN$(DIF))
HLR=RK
CALL DRAWHS(DIF,6)
HLR=-1
WAIT 30
DO
  CALL STEPSTARS
  PAL 4
  IF T MOD 60<40 THEN
    CALL CTEXT(14,"PRESS A")
  ELSE
    CALL CTEXT(14,"       ")
  END IF
  INC T
  IF BUTTON TAP(0,0) THEN EXIT
  WAIT VBL
LOOP
STOP
GOTO TITLE

'=================================
'ENEMY WAVE SCRIPTS
'FRAME, TYPE, X, COUNT, GAP, X STEP
'TYPE 0 DART, 1 ORB, 2 GUNSHIP
W1:
DATA 30,0,30,5,14,0
DATA 200,0,114,5,14,0
DATA 400,1,-16,3,40,0
DATA 620,1,160,3,40,0
DATA 860,2,72,1,0,0
DATA 900,0,10,4,14,0
DATA 960,0,134,4,14,0
DATA 1200,2,30,2,50,84
DATA 1300,1,-16,3,30,0
DATA -1,0,0,0,0,0
W2:
DATA 30,2,30,2,40,84
DATA 220,0,20,6,10,20
DATA 420,1,160,4,30,0
DATA 640,0,130,6,10,-20
DATA 860,2,10,3,40,60
DATA 1100,1,-16,4,30,0
DATA 1300,0,60,8,8,0
DATA -1,0,0,0,0,0
W3:
DATA 30,0,20,6,10,24
DATA 200,1,-16,4,25,0
DATA 380,1,160,4,25,0
DATA 560,2,20,3,30,50
DATA 800,0,140,6,10,-24
DATA 960,0,10,6,10,24
DATA 1150,2,72,1,0,0
DATA 1160,1,-16,3,30,0
DATA 1180,1,160,3,30,0
DATA -1,0,0,0,0,0

'=================================
'RUNS BEFORE EVERY SCREEN LINE
SUB RAS
  R=RASTER
  IF R=0 THEN
    SCROLL 1,0,0
    POKE $FF20,%101
  ELSE IF R=12 THEN
    SCROLL 1,0,RA
    POKE $FF20,SEN
  ELSE IF R=WL THEN
    SCROLL 1,0,RB
  END IF
  IF FLR THEN
    IF R>=56 THEN
      J=R-56
      IF J=0 THEN POKE $FF20,%111
      SCROLL 0,FXL(J),0
      PALETTE 5,,FPL(J),,
    END IF
  ELSE IF WOB THEN
    SCROLL 0,BGSX+WT((R\2+WP) AND 15)*WAMP,BGSY
  ELSE IF TGR THEN
    IF R>=24 AND R<32 THEN
      K=(R+TGR\2) AND 7
      PALETTE 7,,GA(K),GB(K),63
    END IF
  END IF
END SUB

'STARS: BG1 ROWS 2-31 FORM A 240 PX
'RING. THE RASTER SUB SKIPS THE HUD
'ROWS SO THEY NEVER SCROLL INTO VIEW
SUB STEPSTARS
  ADD SY1,-1,0 TO 239
  IF SY1<228 THEN
    RA=SY1+16
  ELSE
    RA=(SY1+32) AND 255
  END IF
  RB=(SY1+32) AND 255
  WL=240-SY1
  IF WL<=12 THEN WL=-1
END SUB

SUB SETUPSTARS
  BG 1
  CLS 1
  PAL 0
  FOR I=0 TO 70
    CELL RND(19),2+RND(29),33+RND(2)
  NEXT I
END SUB

SUB HUD
  BG 1
  BG FILL 0,0 TO 19,1 CHAR 0
  PAL 6
  NUMBER 0,0,SC,6
  IF PH=0 THEN
    TEXT 11,0,"HI"
    NUMBER 14,0,HI,6
  ELSE IF LIVES>=0 THEN
    TEXT 7,0,"X"
    NUMBER 8,0,INT(MUL),1
    PAL 4
    FOR K=0 TO 2
      IF K<BOMBS THEN CELL 13+K,0,47 ELSE CELL 13+K,0,0
    NEXT K
    PAL 1
    FOR K=0 TO 2
      IF K<LIVES THEN CELL 17+K,0,39 ELSE CELL 17+K,0,0
    NEXT K
  END IF
  LHB=-1
END SUB

SUB CTEXT(ROW,M$)
  TEXT (20-LEN(M$))\2,ROW,M$
END SUB

SUB RESETPLAY
  CALL CLEARB
  SPRITE OFF
  FLR=0
  SEN=%111
  WOB=0
  WAMP=1
  BG 0
  CLS 0
  SY0=0
  SCROLL 0,0,0
  BMT=0
  PALETTE 0,1,,,
  PALETTE 5,,18,39,63
  CURT=0
  CC=0
  LCR=-1
  GP=7
  NB=12
  NS=6
  A1=0
  RO=0
  T=0
  PALETTE 3,,32,52,60
END SUB

SUB CLEARB
  FOR I=12 TO 63
    BA(I)=0
    BK(I)=0
  NEXT I
  SPRITE OFF 12 TO 63
END SUB

'ALL GAMEPLAY SCORING GOES THROUGH
'THE MULTIPLIER
SUB SCORE(N)
  ADD SC,N*INT(MUL)
END SUB

SUB ADDMUL(V)
  OLD=INT(MUL)
  MUL=MIN(8.99,MUL+V)
  IF INT(MUL)>OLD THEN
    PLAY 3,68+INT(MUL)*3,8 SOUND 4
    IF INT(MUL)>MMAX THEN MMAX=INT(MUL)
  END IF
END SUB

SUB BOSSHIT
  DEC HP
  CALL SCORE(10)
  FL=2
  IF HP MOD 4=0 THEN PLAY 3,40,1 SOUND 6
END SUB

'BK: 0 BULLET, 1 SCORE GEM, 2 SPARK,
'3 EXPLOSION (ANIMATES, THEN EXPIRES)
SUB MOVEB
  FOR I=12 TO 63
    IF BA(I) THEN
      IF BK(I)=3 THEN
        INC BAG(I)
        IF BAG(I)>=15 THEN
          BA(I)=0
          BK(I)=0
          SPRITE OFF I
        ELSE
          ADD BX(I),BDX(I)
          ADD BY(I),BDY(I)
          SPRITE I,BX(I),BY(I),EXC(BAG(I)\5)
        END IF
      ELSE IF BK(I)=1 THEN
        'GEMS ACCELERATE TOWARD THE PLAYER
        DX=PX+4-BX(I)
        DY=PY+4-BY(I)
        D=ABS(DX)+ABS(DY)
        IF D<6 THEN
          CALL SCORE(30*TN(BT(I)))
          CALL ADDMUL(0.03)
          BA(I)=0
          BK(I)=0
          SPRITE OFF I
          PLAY 2,72+INT(MUL)*2+RND(4),2 SOUND 4
        ELSE
          ADD BDX(I),0.3
          F=MIN(1,BDX(I)/D)
          ADD BX(I),DX*F
          ADD BY(I),DY*F
          SPRITE I,BX(I),BY(I),
        END IF
      ELSE
        ADD BX(I),BDX(I)
        ADD BY(I),BDY(I)
        IF BY(I)>130 OR BY(I)<-24 OR BX(I)<-24 OR BX(I)>162 THEN
          BA(I)=0
          SPRITE OFF I
        ELSE
          SPRITE I,BX(I),BY(I),
        END IF
      END IF
    END IF
  NEXT I
END SUB

'TURN EVERY LIVE BULLET INTO A GEM
'WORTH 30 PER BULLET IT CARRIED
SUB CANCEL
  FOR I=12 TO 63
    IF BA(I) THEN
      IF BK(I)=0 THEN
        BK(I)=1
        BDX(I)=0
        ADD BX(I),HS(BT(I))-4
        ADD BY(I),HS(BT(I))-4
        SPRITE I,BX(I),BY(I),7
        SPRITE I PAL 4 SIZE 0
      END IF
    END IF
  NEXT I
END SUB

SUB BOMB
  DEC BOMBS
  IF INV<110 THEN INV=110
  BMT=16
  MUL=MAX(1,MUL/2)
  PLAY 3,4,60 SOUND 7
  CALL CANCEL
  IF WV=2 THEN
    FOR E=0 TO 7
      IF QA(E) THEN CALL HURTE(E,30)
    NEXT E
  END IF
  IF STG=1 AND PH=3 THEN
    CLS 0
    ADD SC,2000
  END IF
  IF BV THEN
    IF STG<>2 OR PH=2 THEN
      ADD HP,-20
    ELSE
      FOR K=0 TO 3
        IF TH(K)>10 THEN
          ADD TH(K),-10
          ADD HP,-10
        END IF
      NEXT K
    END IF
    FL=2
  END IF
  CALL HUD
END SUB

'NEW ENEMY IN THE FIRST FREE SLOT
SUB SPAWN(TY,X0,IX)
  FOR E=0 TO 7
    IF QA(E)=0 THEN
      QA(E)=-1
      QT(E)=TY
      QG(E)=0
      QX(E)=X0
      S=12+E
      BK(S)=4
      IF TY=0 THEN
        'DART: OUR OWN SHIP, UPSIDE DOWN
        QY(E)=-16
        QU(E)=X0
        QH(E)=3
        SPRITE S PAL 2 SIZE 1 FLIP 0,1
        SPRITE S,X0,-16,2
      ELSE IF TY=1 THEN
        'ORB: A BOSS POD, RECOLOURED
        QV(E)=24+IX*14
        QY(E)=QV(E)
        IF X0<80 THEN QU(E)=0.8 ELSE QU(E)=-0.8
        QH(E)=6
        SPRITE S PAL 7 SIZE 1 FLIP 0,0
        SPRITE S,X0,QY(E),138
      ELSE IF TY=2 THEN
        'GUNSHIP: A BATTLESHIP TURRET
        QY(E)=-16
        QH(E)=14
        SPRITE S PAL 3 SIZE 1 FLIP 0,0
        SPRITE S,X0,-16,40
      ELSE
        'SECRET GOLD GUNSHIP
        QY(E)=30
        QH(E)=40
        SPRITE S PAL 4 SIZE 1 FLIP 0,0
        SPRITE S,X0,30,40
      END IF
      EXIT SUB
    END IF
  NEXT E
END SUB

SUB MOVEE
  QL=0
  FOR E=0 TO 7
    IF QA(E) THEN
      INC QG(E)
      G=QG(E)
      TY=QT(E)
      X0=QX(E)+8
      Y0=QY(E)+8
      IF TY=0 THEN
        ADD QY(E),1.3
        QX(E)=QU(E)+SIN(G*0.05)*28
        IF G=40 THEN
          CALL AIM(X0,Y0)
          CALL FIRE(X0,Y0+4,AA,1.4,0)
        END IF
      ELSE IF TY=1 THEN
        ADD QX(E),QU(E)
        QY(E)=QV(E)+SIN(G*0.06)*8
        IF G MOD 80=40 THEN
          FOR K=0 TO 5
            CALL FIRE(X0,Y0,K*PI/3+G,0.9,1)
          NEXT K
        END IF
      ELSE IF TY=3 THEN
        'LOOPS ACROSS THE TOP, THEN BOLTS
        QX(E)=72+SIN(G*0.03)*84
        QY(E)=30+SIN(G*0.07)*12
        IF G>420 THEN QY(E)=30-(G-420)*2
      ELSE
        IF G<70 THEN
          ADD QY(E),0.7
        ELSE IF G>260 THEN
          ADD QY(E),-0.8
        END IF
        IF G=100 OR G=160 OR G=220 THEN
          CALL AIM(X0,Y0)
          FOR K=-1 TO 1
            CALL FIRE(X0,Y0+6,AA+K*0.25,1.2,0)
          NEXT K
        END IF
      END IF
      IF QY(E)>132 OR QX(E)<-24 OR QX(E)>168 OR (TY>=2 AND G>260 AND QY(E)<-18) THEN
        QA(E)=0
        INC QESC
        SPRITE OFF 12+E
      ELSE
        BK(12+E)=4
        SPRITE 12+E,QX(E),QY(E),
        INC QL
      END IF
    END IF
  NEXT E
END SUB

SUB HURTE(E,D)
  ADD QH(E),-D
  IF QH(E)<=0 THEN
    QA(E)=0
    S=12+E
    SPRITE OFF S
    BK(S)=0
    CALL FIRE(QX(E)+8,QY(E)+8,0,0,6)
    IF QT(E)=0 THEN
      CALL SCORE(200)
    ELSE IF QT(E)=1 THEN
      CALL SCORE(400)
    ELSE IF QT(E)=2 THEN
      CALL SCORE(1000)
    ELSE
      CALL SCORE(5000)
      IF BOMBS<3 THEN INC BOMBS
      CALL HUD
      PLAY 2,96,30 SOUND 4
    END IF
    CALL ADDMUL(0.05)
    PLAY 3,24+RND(6),14 SOUND 5
  ELSE
    PLAY 3,50,1 SOUND 6
  END IF
END SUB

'PSEUDO-3D FLOOR INTO BG0 ROWS 7-15
SUB DRAWFLOOR
  BG 0
  BG SOURCE ROM(4)
  BG COPY 0,0,32,9 TO 0,7
  BG SOURCE ROM(3)
  PALETTE 5,,FC(0),48,15
  FOR J=0 TO 5
    FXL(J)=48
    FPL(J)=1
  NEXT J
  SEN=%101
  FLR=-1
END SUB

'HIGH SCORES LIVE IN PERSISTENT RAM:
'$E010 + DIFFICULTY*35 + RANK*7 =
'SCORE (4 BYTES) + 3 LETTERS
SUB HSINIT
  IF PEEK($E004)<>77 THEN
    FOR D=0 TO 2
      FOR R=0 TO 4
        A=$E010+D*35+R*7
        POKEL A,(5-R)*20000
        POKE A+4,78
        POKE A+5,88
        POKE A+6,33
      NEXT R
    NEXT D
    POKE $E004,77
  END IF
  IF PEEK($E006)<>1 THEN
    FOR R=0 TO 4
      A=$E010+3*35+R*7
      POKEL A,(5-R)*40000
      POKE A+4,78
      POKE A+5,88
      POKE A+6,33
    NEXT R
    POKE $E006,1
  END IF
  HLR=-1
END SUB

SUB DRAWHS(D,R0)
  BG 0
  FOR R=0 TO 4
    A=$E010+D*35+R*7
    IF R=HLR THEN PAL 4 ELSE PAL 6
    NUMBER 3,R0+R,R+1,1
    TEXT 6,R0+R,CHR$(PEEK(A+4))+CHR$(PEEK(A+5))+CHR$(PEEK(A+6))
    NUMBER 11,R0+R,PEEKL(A),6
  NEXT R
END SUB

'STEP TO THE NEXT UNLOCKED MODE
SUB NEXTMODE(DR)
  FOR K=1 TO 4
    MODE=(MODE+DR+4) MOD 4
    IF MODE=0 THEN EXIT SUB
    IF MODE<3 AND (UNL AND 1) THEN EXIT SUB
    IF MODE=3 AND (UNL AND 8) THEN EXIT SUB
  NEXT K
END SUB

SUB TPANEL(P)
  BG 0
  BG FILL 0,9 TO 19,13 CHAR 0
  IF P=0 THEN
    PAL 1
    CALL CTEXT(10,"A FIRE  B FOCUS")
    CALL CTEXT(11,"BB BOMB")
    CALL CTEXT(12,"GRAZE TO CHAIN")
  ELSE
    CALL DRAWHS(DIF,9)
  END IF
END SUB

'TRUE FINAL BOSS: THE EYE DRIFTS ON
'BG0, FOUR SHIELD PODS ORBIT IT
SUB EYEMOVE
  IF SYP<10 THEN
    ADD SYP,0.5
  ELSE IF PHT=0 THEN
    BV=-1
  END IF
  SXP=48+SIN(T*0.013)*44
  BGSX=-INT(SXP) AND 255
  BGSY=(16-INT(SYP)) AND 255
  IF WOB=0 THEN SCROLL 0,BGSX,BGSY
  IF T MOD 2=0 THEN INC WP
  EGX=SXP+32
  EGY=SYP+32
  PAE=T*0.025*(1+PH*0.4)
  FOR K=0 TO 3
    A=PAE+K*PI/2
    PDX(K)=EGX+COS(A)*44-8
    PDY(K)=EGY+SIN(A)*30-8
    Y=PDY(K)
    IF Y<4 THEN Y=-32
    SPRITE 2+K,PDX(K),Y,138
  NEXT K
END SUB

SUB EYEFIRE
  IF PH=1 THEN
    'HAIL: BULLETS FALL FROM THE SKY,
    'RINGS FROM THE EYE
    IF T MOD 5=0 THEN CALL FIRE(8+RND(144),14,PI/2+(RND-0.5)*0.3,0.9+RND*0.6,0)
    IF T MOD 60=0 THEN
      FOR K=0 TO 9
        CALL FIRE(EGX,EGY,K*PI/5+RO,0.8,1)
      NEXT K
      ADD RO,0.2
    END IF
  ELSE IF PH=2 THEN
    'VORTEX: PODS SPRAY ALONG THEIR ORBIT
    IF T MOD 14=0 THEN
      FOR K=0 TO 3
        CALL FIRE(PDX(K)+8,PDY(K)+8,PAE+K*PI/2+PI/2,1.1,3)
      NEXT K
    END IF
    IF T MOD 45=0 THEN
      CALL AIM(EGX,EGY)
      CALL FIRE(EGX,EGY,AA,1,2)
    END IF
  ELSE
    'STORM EYE: 4-ARM FLOWER THAT
    'REVERSES, AIMED FANS, LIGHTNING
    IF T MOD 12=0 THEN
      FOR K=0 TO 3
        CALL FIRE(EGX,EGY,A1+K*PI/2,0.95,2)
      NEXT K
      ADD A1,ESP
      IF T MOD 180=0 THEN ESP=-ESP
    END IF
    IF T MOD 60=30 THEN
      CALL AIM(EGX,EGY)
      FOR K=-3 TO 3
        CALL FIRE(EGX,EGY,AA+K*0.18,1.5,0)
      NEXT K
    END IF
    IF RND<0.012 AND BMT=0 THEN
      BMT=8
      PLAY 3,4,20 SOUND 7
    END IF
  END IF
END SUB

SUB TURRETDOWN(K)
  SPRITE 2+K,,,42
  ADD SC,2000
  PLAY 3,14,30 SOUND 5
  CALL FIRE(SXP+TOX(K)+8,SYP+TOY(K)+8,0,0,6)
  FOR J=0 TO 5
    CALL FIRE(SXP+TOX(K)+8,SYP+TOY(K)+8,J*PI/3,0.9,5)
  NEXT J
END SUB

SUB FIRE(X0,Y0,AN,SPD,TY)
  I=NB
  IF NB<BLO THEN NB=BLO
  ADD NB,1,BLO TO 63
  IF BA(I) THEN EXIT SUB
  BA(I)=-1
  BK(I)=0
  IF TY=5 THEN BK(I)=2
  IF TY=6 THEN
    BK(I)=3
    BAG(I)=0
  END IF
  BT(I)=TY
  BX(I)=X0-HS(TY)
  BY(I)=Y0-HS(TY)
  BDX(I)=COS(AN)*SPD*DSP
  BDY(I)=SIN(AN)*SPD*DSP
  SPRITE I,BX(I),BY(I),TC(TY)
  SPRITE I PAL TP(TY) SIZE TZ(TY)
END SUB

SUB AIM(X0,Y0)
  DX=PX+8-X0
  DY=PY+8-Y0
  IF DX=0 THEN DX=0.001
  AA=ATAN(DY/DX)
  IF DX<0 THEN AA=AA+PI
END SUB

SUB PLAYERDIE
  DEC LIVES
  INC NDEATH
  IF BOMBS<3 THEN BOMBS=3
  MUL=1
  INV=150
  DEAD=45
  PLAY 3,8,40 SOUND 5
  CALL CLEARB
  CALL FIRE(PX+8,PY+8,0,0,6)
  FOR K=0 TO 7
    CALL FIRE(PX+8,PY+8,K*PI/4,1.1,5)
  NEXT K
  SPRITE OFF 0 TO 1
  CALL HUD
END SUB

'STAGE 1 PHASE CHANGE (WITH TEXT)
SUB NEWPHASE(P,M$)
  PH=P
  BV=0
  PHT=90
  ADD SC,1000
  CALL CANCEL
  BG 0
  CLS 0
  SY0=0
  SCROLL 0,0,0
  PAL 3
  CALL CTEXT(8,M$)
  PLAY 3,30,20 SOUND 5
END SUB

'STAGE 2/3 PHASE CHANGE (NO TEXT, BG0
'IS BUSY WITH THE SHIP OR THE FLOOR)
SUB PHASEUP(P)
  PH=P
  BV=0
  PHT=70
  ADD SC,5000
  CALL CANCEL
  FL=2
  PLAY 3,20,40 SOUND 5
END SUB
